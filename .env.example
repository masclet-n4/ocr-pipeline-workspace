# Puertos publicados en el host
OCR_PORT=3000
OCR_FRONT_PORT=3001

# PocketBase y RustFS deben estar accesibles desde los contenedores
PB_URL=http://host.docker.internal:8090
RUSTFS_ENDPOINT=http://host.docker.internal:9000
RUSTFS_BUCKET=ocr-results
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_REGION=us-east-1
RUSTFS_URL_EXPIRES_SECONDS=300

# Configuración del OCR
OCR_RENDER_SCALE=1.5
OCR_MEMORY_TRIM=1
TESSERACT_LANG=spa+eng
TESSERACT_PSM=3
OCR_ISOLATE_PROCESS=1


# Interpretador (modelo económico de OpenRouter con structured outputs)
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-5-nano
INTERPRETER_MAX_TEXT_BYTES=524288
OPENROUTER_MAX_TOKENS=4096
